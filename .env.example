# Application
APP_NAME="Padma"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local development shows a mock-account button backed by src/mock-data.
# Set to "oauth" to remove it and exercise real GitHub and Google flows.
AUTH_MODE="mock"

# Database (matches compose.yaml)
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/padma?schema=public"

# `npm run setup` fills these once and preserves them on safe reruns.
# To generate unique values manually:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Production builds intentionally fail when either value is blank.
BETTER_AUTH_SECRET=""
INTEGRATION_ENCRYPTION_KEY=""

# Used only when AUTH_MODE="oauth". Configure either or both providers.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated additional origins, for example https://preview.example.com
TRUSTED_ORIGINS=""

# Optional OpenTelemetry-compatible collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=""
